{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trentbest.github.io/TheSingularityWorkshop.SingularityUniversalRoleplayingSystem/schemas/scenario-story-graph.schema.json",
  "title": "SURPS Scenario Story Graph",
  "description": "A versioned authoring graph for player choices and narrative scene transitions. This schema does not define a runtime, adjudicator, or secure referee-data store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experienceId",
    "graphId",
    "version",
    "entryNodeId",
    "semantics",
    "stateKeys",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "experienceId": {
      "type": "string",
      "minLength": 1
    },
    "graphId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "entryNodeId": {
      "type": "string",
      "minLength": 1
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "transitionAuthority",
        "presentationBoundary"
      ],
      "properties": {
        "purpose": {
          "type": "string"
        },
        "transitionAuthority": {
          "type": "string"
        },
        "presentationBoundary": {
          "type": "string"
        }
      }
    },
    "stateKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "playerPresentation",
          "choices"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "scene",
              "ending"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "playerPresentation": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "intent",
                "resolution",
                "nextNodeId"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "intent": {
                  "type": "string",
                  "minLength": 1
                },
                "resolution": {
                  "description": "direct means the declared transition may be committed immediately. referee means the choice records pending intent only; a human referee must adjudicate and explicitly accept the transition before navigation or state effects occur.",
                  "enum": [
                    "direct",
                    "referee"
                  ]
                },
                "requiresAll": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "setsAll": {
                  "description": "Scenario state effects to apply only when this choice transition is committed. For referee choices, do not apply these when the player merely selects the choice.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "nextNodeId": {
                  "description": "The continuation node after the transition is committed. For referee choices this is not permission to navigate immediately, and in schema version 1 it does not encode separate destinations for different adjudication outcomes.",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
