{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trentbest.github.io/TheSingularityWorkshop.SingularityUniversalRoleplayingSystem/schemas/microbundle-registry.schema.json",
  "title": "SURPS MicroBundle Registry",
  "description": "Repository-local discovery index for independently owned and versioned MicroBundle descriptors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "microbundles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "microbundles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"}, "path": {"type": "string", "minLength": 1}}}}
  }
}