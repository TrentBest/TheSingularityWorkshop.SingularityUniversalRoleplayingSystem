{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trentbest.github.io/TheSingularityWorkshop.SingularityUniversalRoleplayingSystem/schemas/book-contribution.schema.json",
  "title": "SURPS Book Contribution",
  "description": "Machine-readable, versioned content contributed by one registered SURPS book. Descriptors identify books; contribution documents declare the actual selectable content and rule metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "book",
    "contributions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
        },
        "status": {
          "enum": [
            "proposed",
            "draft",
            "playtest",
            "published",
            "deprecated"
          ]
        },
        "source": {
          "type": "string"
        },
        "ownerRepository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        }
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characterOptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/characterOption"
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trait"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "creations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/creation"
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentItem"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentItem"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surpsCharacterContract": {
          "type": "string"
        },
        "requiresBooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflictsWithBooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "versionRange": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "characterOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "ancestry",
            "heritage",
            "culture",
            "background",
            "occupation",
            "archetype",
            "lineage",
            "form",
            "origin",
            "other"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "selectionGroup": {
          "type": "string"
        },
        "grantsTraits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "grantsCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "grantsEquipment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "grantsResources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modifier"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "advantage",
            "disadvantage",
            "ability",
            "disability",
            "feature",
            "condition",
            "mutation",
            "other"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selectable": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/reference"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "specified",
            "implemented",
            "partial",
            "experimental",
            "planned"
          ]
        },
        "scope": {
          "type": "string"
        },
        "when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          }
        },
        "requiresCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "evaluator": {
          "$ref": "#/$defs/reference"
        },
        "priority": {
          "type": "integer"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "valueType"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "valueType": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "entity-reference",
            "quantity",
            "enum"
          ]
        },
        "unit": {
          "type": "string"
        },
        "dimension": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "operation",
        "value"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "add",
            "multiply",
            "set",
            "grant",
            "remove",
            "constrain",
            "tag"
          ]
        },
        "value": {},
        "when": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "enum": [
            "grant-capability",
            "remove-capability",
            "modify-attribute",
            "add-condition",
            "remove-condition",
            "modify-resource",
            "emit-event",
            "provider-delegation",
            "descriptive-only"
          ]
        },
        "target": {
          "type": "string"
        },
        "value": {},
        "when": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/reference"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "creation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "species",
            "creature",
            "person-template",
            "npc-template",
            "item",
            "weapon",
            "armor",
            "vehicle",
            "structure",
            "location",
            "faction",
            "organization",
            "hazard",
            "environment",
            "other"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "template": {
          "type": "object"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "payload"
      ],
      "properties": {
        "namespace": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
