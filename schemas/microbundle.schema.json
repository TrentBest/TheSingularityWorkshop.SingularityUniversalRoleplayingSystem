{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trentbest.github.io/TheSingularityWorkshop.SingularityUniversalRoleplayingSystem/schemas/microbundle.schema.json",
  "title": "SURPS MicroBundle Descriptor",
  "description": "Stable identity, ownership, structured content, reusable book assets, and optional action-preview compositions for an independently versioned content bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "ownerRepository",
    "domain",
    "contentPath",
    "contentSchema",
    "recordCollections"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "proposed",
        "draft",
        "playtest",
        "published",
        "deprecated"
      ]
    },
    "ownerRepository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "contentPath": {
      "type": "string",
      "minLength": 1
    },
    "contentSchema": {
      "const": "schemas/microbundle-content.schema.json"
    },
    "assetsPath": {
      "type": "string",
      "minLength": 1
    },
    "assetsSchema": {
      "const": "schemas/microbundle-assets.schema.json"
    },
    "sourceBookId": {
      "type": "string"
    },
    "recordCollections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "characterOptions",
          "traits",
          "capabilities",
          "rules",
          "creations",
          "equipment",
          "resources",
          "extensions"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "versionRange": {
            "type": "string"
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceRepository": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "previewsPath": {
      "type": "string",
      "minLength": 1
    },
    "previewsSchema": {
      "const": "schemas/action-preview-manifest.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "assetsPath"
        ]
      },
      "then": {
        "required": [
          "assetsSchema"
        ]
      }
    },
    {
      "if": {
        "required": [
          "previewsPath"
        ]
      },
      "then": {
        "required": [
          "previewsSchema"
        ]
      }
    }
  ]
}
