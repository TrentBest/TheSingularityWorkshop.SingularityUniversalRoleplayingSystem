  "ownershipPolicy": {
    "description": "Each book has one accountable owning repository. Multiple repositories may contribute authoritative domain material. Similar books in different settings, eras, or traditions remain distinct records linked by a shared familyId.",
    "claimMethod": "Agent submits a pull request to SURPS development updating the book ownership claim with repository, agent identity, canonical book URL, source path, and evidence. Claims remain pending until reviewed and accepted.",
